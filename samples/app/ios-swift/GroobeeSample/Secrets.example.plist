<?xml version="1.0" encoding="UTF-8"?>
<!--
  Groobee iOS 샘플 설정 (예시)

  이 파일을 같은 폴더의 Secrets.plist 로 복사한 뒤 값을 채우세요:
    cp GroobeeSample/Secrets.example.plist GroobeeSample/Secrets.plist

  Secrets.plist 는 .gitignore 대상이며, 없으면 placeholder 로 동작합니다.
  (번들 ID 는 project.yml 의 PRODUCT_BUNDLE_IDENTIFIER 에서 설정)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GROOBEE_SERVICE_KEY</key>
	<string>YOUR_GROOBEE_SERVICE_KEY</string>
	<key>GROOBEE_RECOMMEND_CAMPAIGN_KEY</key>
	<string>YOUR_RECOMMEND_CAMPAIGN_KEY</string>
</dict>
</plist>
