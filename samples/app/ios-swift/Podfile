platform :ios, '13.0'

use_frameworks!

target 'GroobeeSample' do
  # ────────────────────────────────────────────────────────────────
  # Groobee iOS SDK (CocoaPods, 배포 저장소 git 태그)
  #   현재 Stable: 1.1.15
  #   최신 태그 확인: https://github.com/groobee/groobee-ios-sdk-release/tags
  #   (CocoaPods Trunk 는 2026-12-02 부터 읽기 전용이라 :git + :tag 로 설치합니다.
  #    버전을 올릴 때는 :tag 값을 바꾸세요.)
  # ────────────────────────────────────────────────────────────────
  pod 'GroobeeKit', :git => 'https://github.com/groobee/groobee-ios-sdk-release.git', :tag => '1.1.15'

  # ── Firebase Cloud Messaging (푸시) ──────────────────────────────
  #   푸시가 필요 없으면 아래 두 줄과
  #   GroobeeSample/GoogleService-Info.plist 추가 단계를 생략하세요.
  pod 'FirebaseCore'
  pod 'FirebaseMessaging'
end
