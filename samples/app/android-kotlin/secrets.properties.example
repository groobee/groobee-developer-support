# Groobee Android 샘플 설정 (예시)
#
# 이 파일을 secrets.properties 로 복사한 뒤 값을 채우세요:
#   cp secrets.properties.example secrets.properties
#
# secrets.properties 는 .gitignore 에 등록되어 커밋되지 않습니다.
# 값을 채우지 않아도(또는 파일이 없어도) placeholder 로 빌드는 됩니다.

# 어드민에서 발급받은 서비스키
groobee.serviceKey=YOUR_GROOBEE_SERVICE_KEY

# 추천 캠페인키 (어드민 > 추천 캠페인)
groobee.recommendCampaignKey=YOUR_RECOMMEND_CAMPAIGN_KEY

# 앱 패키지(applicationId). 변경 시 app/google-services.json 의 package_name 도 일치시키세요.
groobee.applicationId=io.groobee.sample
